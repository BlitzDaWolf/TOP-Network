<Window x:Class="PacketWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:packetwpf="clr-namespace:PacketWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000">
    <Grid>
        <ScrollViewer Margin="200,0,0,0" Width="895" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
            <packetwpf:HexViewer x:Name="viewer" Width="875" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
        <TreeView HorizontalAlignment="Left" Width="200" x:Name="treeView" SelectedItemChanged="treeView_SelectedItemChanged"/>
        <TreeView HorizontalAlignment="Right" Width="800" Margin="695,0,0,0" x:Name="classV"/>
    </Grid>
</Window>
